# ==============================================================================
# Al-Alamiya ERP/POS — Production Environment Configuration (.env.production)
# معرض العالمية للمفروشات (Al-Alamiya Home Textiles Showroom)
# ==============================================================================
# DEPLOYMENT TARGET: Single Shop PC (Windows) acting as LAN server + Database.
# Showroom upstairs device connects over local Wi-Fi / Ethernet via LAN IP.
# Strictly NO public internet exposure / NO port forwarding on the router.
# ==============================================================================

# Application Environment & Core Security
APP_NAME="Al-Alamiya ERP"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=http://192.168.1.100:8000

# Locale & Timezone (Africa/Cairo is the authoritative timezone for showrooms in Egypt)
APP_TIMEZONE=Africa/Cairo
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG
CURRENCY=EGP

# Maintenance & Logging (Daily log rotation with 14-day retention, INFO level)
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Production Database (MariaDB / MySQL on Windows LAN server)
# Ensure collation is utf8mb4_unicode_ci for full Arabic character support
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=elalamya_production
DB_USERNAME=elalamya_user
DB_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session & Cache Drivers
# In production, use 'file' or 'database' so reports unlock state persists reliably.
# NEVER use 'array' driver in production.
SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
CACHE_PREFIX=elalamya_cache

# Queue & Filesystem
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Sanctum Token Lifetime (Minutes: 720 minutes = 12 hours full shift)
SANCTUM_EXPIRATION=720

# CORS Allowed Origins
# Limit strictly to the LAN frontend origins (Shop PC local browser + upstairs device)
# Replace 192.168.1.100 with the static LAN IP assigned to the Shop PC
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.100:3000,http://192.168.1.100:8000

# Trusted Proxies (Only if using local reverse proxy such as Caddy/Nginx on Windows)
# TRUSTED_PROXIES=127.0.0.1,192.168.1.0/24
