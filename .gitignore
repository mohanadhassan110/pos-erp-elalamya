# Root Git Ignore for Al-Alamiya ERP / POS Monorepo

# Environment & Secrets (AGENTS.md Section 24)
.env
.env.backup
.env.production
.env.local
.env.*.local
*.key
auth.json

# Backend dependencies & artifacts
/backend/vendor/
/backend/node_modules/
/backend/.phpunit.cache/
/backend/.phpunit.result.cache
/backend/public/build/
/backend/public/hot
/backend/public/storage
/backend/bootstrap/cache/*
!/backend/bootstrap/cache/.gitignore
/backend/storage/logs/*.log
/backend/storage/framework/cache/data/*
!/backend/storage/framework/cache/data/.gitignore
/backend/storage/framework/sessions/*
!/backend/storage/framework/sessions/.gitignore
/backend/storage/framework/views/*
!/backend/storage/framework/views/.gitignore
/backend/storage/framework/testing/*
!/backend/storage/framework/testing/.gitignore
/backend/storage/app/public/*
!/backend/storage/app/public/.gitignore
/backend/database/*.sqlite
/backend/database/*.sqlite-journal

# Frontend dependencies & build output
/frontend/node_modules/
/frontend/dist/
/frontend/dist-ssr/
/frontend/*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors & IDEs
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
